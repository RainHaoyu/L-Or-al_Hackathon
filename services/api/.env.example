# 阿里云百炼 DashScope（qwen-vl-max 瓶身识别 / qwen-max 通感文案）
# 未配置时系统自动进入 mock 演示模式（识别走本地模拟、文案走规则模板），全链路可跑通
DASHSCOPE_API_KEY=

# 模型号（后台可升级：换新模型只改配置，不改代码、不重发前端）
QWEN_VISION_MODEL=qwen-vl-max
QWEN_TEXT_MODEL=qwen-max
QWEN_TEXT_MODEL_FALLBACK=qwen-plus

# 阿里云 读光OCR / 视觉智能条码识别（凭证位预留，未接入时相关通道走 mock/手动输入）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# 跨域（逗号分隔；默认 * 便于演示）
CORS_ORIGINS=*
